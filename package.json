{
  "name": "candle-wizard",
  "version": "0.1.0",
  "private": true,
  "description": "Supabase-backed candle inventory, production, purchasing, costing and lot traceability.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:domain && npm run build",
    "test:domain": "node --experimental-strip-types --test tests/domain.test.ts",
    "db:seed:generate": "node --experimental-strip-types supabase/generate-seed.ts",
    "lint": "eslint . --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.3.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Candle Manufacturing OS"
}
